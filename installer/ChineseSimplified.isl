; ============================================================================
;  简体中文语言包 / Chinese (Simplified) messages for Inno Setup 6
;  Shimeji 桌宠
;
;  Inno Setup 6 官方没有提供简体中文语言包（只带了 29 个语言，不含中文），
;  所以这个文件是基于 compiler:Default.isl 手工翻译的。
;
;  注意：原文没有句号的译文也不要加句号 —— Inno Setup 会自己补上。
;  Note: do NOT add trailing periods that the English original lacks; Inno
;  Setup appends them automatically.
;
;  键集合与 Default.isl 完全一致（[Messages] + [CustomMessages] 共 293 个）。
; ============================================================================

[LangOptions]
LanguageName=简体中文
LanguageID=$0804
LanguageCodePage=936
DialogFontName=Microsoft YaHei UI
DialogFontSize=9

[Messages]
SetupAppTitle=安装
SetupWindowTitle=安装 - %1
UninstallAppTitle=卸载
UninstallAppFullTitle=%1 卸载
InformationTitle=信息
ConfirmTitle=确认
ErrorTitle=错误
